#!/bin/bash
set -euo pipefail

HERE="$(cd "$(dirname "$0")" && pwd)"
REPO="$(cd "$HERE/../../../.." && pwd)"
BIN="$REPO/.venv/bin/pdftoepub"
PYTHON="${PYTHON:-/usr/bin/python3}"

if [[ ! -x "$BIN" ]]; then
  osascript -e 'display notification "Setting up PdfToEpub…" with title "PdfToEpub"'
  "$PYTHON" -m venv "$REPO/.venv"
  "$REPO/.venv/bin/pip" install -e "$REPO"
fi

if [[ $# -eq 0 ]]; then
  if curl -sf -o /dev/null --connect-timeout 1 "http://127.0.0.1:8765/" \
    || lsof -nP -iTCP:8765 -sTCP:LISTEN >/dev/null 2>&1; then
    open "http://127.0.0.1:8765"
    exit 0
  fi
  exec "$BIN" serve --open
fi

"$BIN" convert --open --skip-existing "$@"
code=$?
if [[ $code -ne 0 ]]; then
  osascript -e 'display dialog "Conversion failed. Check that the file is a readable PDF." buttons {"OK"} default button "OK" with title "PdfToEpub"'
fi
exit $code
